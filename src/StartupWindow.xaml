<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Spacio" Width="640" Height="420" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterScreen"
 Background="#0E1915" Foreground="#E6F4EC" FontFamily="Segoe UI, Tahoma" UseLayoutRounding="True">
 <Border Background="#0E1915" BorderBrush="#345745" BorderThickness="1" Padding="30">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="65"/></Grid.RowDefinitions>
   <Grid><TextBlock Text="S P A C I O   /   S T O R A G E" Foreground="#7BA38E" FontSize="10" VerticalAlignment="Center"/><Button x:Name="CloseSplash" Content="×" HorizontalAlignment="Right" Width="28" Height="28" FontSize="20" Background="Transparent" Foreground="#92B2A0" BorderThickness="0" Cursor="Hand"/></Grid>
   <Grid Grid.Row="1">
    <Ellipse Width="270" Height="270" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
     <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#224F38" Offset="0"/><GradientStop Color="#0E1915" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
    </Ellipse>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
     <Grid Width="100" Height="100" Margin="0,0,0,14">
      <Ellipse Stroke="#37654B" StrokeThickness="1" Margin="0"/>
      <Ellipse Stroke="#609A74" StrokeThickness="1" Margin="8" Opacity="0.5"/>
      <Image x:Name="SplashLogo" Width="68" Height="68"/>
      <Ellipse Width="8" Height="8" Fill="#9BF0AB" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-3,0,0">
       <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:1"/></Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers>
      </Ellipse>
     </Grid>
     <TextBlock Text="Spacio" FontSize="38" FontWeight="SemiBold" HorizontalAlignment="Center"/>
     <TextBlock x:Name="SplashTagline" Foreground="#A0C2AD" FontSize="13" HorizontalAlignment="Center" Margin="0,7,0,0"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Height="3" Background="#213B2B" CornerRadius="1" ClipToBounds="True">
     <Grid><Border Width="120" HorizontalAlignment="Left" CornerRadius="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#213B2B" Offset="0"/><GradientStop Color="#8ADD9B" Offset="0.5"/><GradientStop Color="#213B2B" Offset="1"/></LinearGradientBrush></Border.Background><Border.RenderTransform><TranslateTransform X="-120"/></Border.RenderTransform><Border.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-120" To="580" Duration="0:0:1.8"/></Storyboard></BeginStoryboard></EventTrigger></Border.Triggers></Border></Grid>
    </Border>
    <TextBlock x:Name="SplashStatus" Grid.Row="1" FontSize="11" Foreground="#98B9A4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Grid Grid.Row="2"><TextBlock x:Name="SplashFootnote" Foreground="#60816C" FontSize="10"/><TextBlock x:Name="SplashVersion" HorizontalAlignment="Right" Foreground="#60816C" FontSize="10"/></Grid>
   </Grid>
  </Grid>
 </Border>
</Window>
