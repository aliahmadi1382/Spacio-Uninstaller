     <Button x:Name="UpdateButton" Tag="بررسی آپدیت" Background="Transparent" Foreground="#85C6AE" FontSize="11" Margin="0,9,0,0" Padding="8,6"/>
     <TextBlock x:Name="VersionLabel" FontSize="9" Foreground="#5F7481" FlowDirection="LeftToRight" HorizontalAlignment="Center" Margin="0,5,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
