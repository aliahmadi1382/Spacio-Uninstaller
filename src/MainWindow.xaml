   </Grid><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ProgressBar x:Name="Activity" Width="55" Height="3" IsIndeterminate="True" Foreground="#6BE2C4" Background="#25332F" BorderThickness="0" Visibility="Collapsed" Margin="0,0,9,0"/><TextBlock x:Name="StatusText" Grid.Column="1" Tag="آمادهٔ اسکن" FontSize="10" Foreground="#7793A2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock x:Name="LiveStatus" FontSize="10" Foreground="#8CE9CE" MaxWidth="240" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" VerticalAlignment="Center"/><Button x:Name="LiveToggle" Tag="توقف پایش" FontSize="10" Padding="7,3" Margin="10,0,0,0" Background="#223630" Foreground="#8CE9CE"/></StackPanel></Grid></Grid>
  </Grid>
  <Grid x:Name="CleanupWorkspace" Grid.Row="1" Grid.Column="1" Margin="26,24,26,14" Visibility="Collapsed">
