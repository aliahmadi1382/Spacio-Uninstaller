 </Window.Resources>
 <Grid Background="#101418">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="UpdateBanner" Grid.Row="0" Grid.ColumnSpan="2" Background="#173B30" BorderBrush="#2D6950" BorderThickness="0,0,0,1" Padding="22,12" Visibility="Collapsed">
