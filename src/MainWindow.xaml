   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="CleanupTitle" Text="Cache" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="CleanupSubtitle" FontSize="12" Foreground="#93ABA5" Margin="0,7,0,0"/></StackPanel>
