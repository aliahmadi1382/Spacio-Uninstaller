    <StackPanel Margin="0,0,18,0"><TextBlock x:Name="UpdateTitle" Foreground="#A3F3CA" FontWeight="SemiBold"/><TextBlock x:Name="UpdateDetail" Foreground="#A6C6B8" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/><ProgressBar x:Name="UpdateProgress" Height="3" Maximum="100" Foreground="#76E7B1" Background="#285342" BorderThickness="0" Margin="0,8,0,0" Visibility="Collapsed"/></StackPanel>
    <Button x:Name="InstallUpdateButton" Grid.Column="1" Tag="دانلود و نصب" Background="#83EBB6" Foreground="#113A28" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed"/>
    <Button x:Name="ReleaseNotesButton" Grid.Column="2" Tag="جزئیات نسخه" Margin="8,0" Background="#24503C" VerticalAlignment="Center"/>
    <Button x:Name="DismissUpdateButton" Grid.Column="3" Tag="بعداً" Background="Transparent" Foreground="#B9D8C9" VerticalAlignment="Center"/>
   </Grid>
  </Border>
  <Border Grid.Row="1" Grid.Column="0" Background="#151C22" BorderBrush="#29333B" BorderThickness="0,0,1,0">
