      <DataGrid.Columns>
       <DataGridTemplateColumn Header="نام" Width="*" MinWidth="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{Binding IconPath}" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Color}" StrokeThickness="1.4" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" TextAlignment="{Binding NameAlignment}"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="اندازه" Binding="{Binding Size}" Width="100"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
       <DataGridTemplateColumn Header="سهم از پوشه" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="43"/></Grid.ColumnDefinitions><ProgressBar Height="4" Value="{Binding Percent}" Maximum="100" Background="#293740" Foreground="{Binding Color}" BorderThickness="0"/><TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="10" Foreground="#A0B2BE" HorizontalAlignment="Right" FlowDirection="LeftToRight"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="آخرین تغییر محتوا" Binding="{Binding Date}" Width="155"/>
