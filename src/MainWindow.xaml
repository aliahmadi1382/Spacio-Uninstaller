     <TextBlock x:Name="ResultCount" Grid.Row="4" Foreground="#7E96A4" FontSize="10" Margin="13,0"/>
    </Grid>
   </Border>
   <Grid Grid.Row="5" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="21"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="SelectionInfo" Tag="انتخابی ندارید" Foreground="#9DB0BD" FontSize="11" TextTrimming="CharacterEllipsis"/>
    <Button x:Name="RevealButton" Grid.Column="1" Tag="نمایش در Explorer" FontSize="11" Padding="11,7" Margin="8,0"/>
