    <Button x:Name="CleanupStop" Grid.Column="2" Tag="توقف" Margin="8,0,0,0" Visibility="Collapsed"/>
   </Grid>
   <Border Grid.Row="3" Background="#161E24" BorderBrush="#2A363F" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
