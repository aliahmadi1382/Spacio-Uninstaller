    <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Tag="فایل" FontSize="10" Foreground="#8B9DA8"/><TextBlock x:Name="FilesMetric" Text="—" FontSize="27" Margin="0,5,0,1"/><TextBlock x:Name="TimeMetric" Text="—" FontSize="10" Foreground="#708692"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Tag="پوشه‌های بررسی‌شده" FontSize="10" Foreground="#8B9DA8"/><TextBlock x:Name="FoldersMetric" Text="—" FontSize="27" Margin="0,5,0,1"/><TextBlock x:Name="ScopeMetric" FontSize="10" Foreground="#708692" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Tag="موارد بررسی‌نشده" FontSize="10" Foreground="#8B9DA8"/><TextBlock x:Name="IssuesMetric" Text="—" FontSize="27" Margin="0,5,0,0" Foreground="#E5BD7F"/><Button x:Name="IssuesButton" Tag="مشاهدهٔ جزئیات" Background="Transparent" Foreground="#9AAEBB" Padding="0,2" FontSize="10" HorizontalAlignment="Left"/></StackPanel></Border>
   </UniformGrid>
   <Border x:Name="OverviewMap" Grid.Row="3" Style="{StaticResource Card}" Padding="15,12" Margin="0,0,0,14">
