    <Grid><TextBox x:Name="CleanupSearch" FontSize="12"/><TextBlock x:Name="CleanupSearchPlaceholder" Tag="جست‌وجو با نام برنامه یا مسیر" FontSize="12" Foreground="#8197A6" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
