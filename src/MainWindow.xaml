     <Button x:Name="LargestNav" Style="{StaticResource Nav}"><TextBlock Tag="فایل‌های بزرگ"/></Button>
     <Button x:Name="OldNav" Style="{StaticResource Nav}"><TextBlock Tag="فایل‌های قدیمی"/></Button>
     <Button x:Name="TypesNav" Style="{StaticResource Nav}"><TextBlock Tag="نوع فایل‌ها"/></Button>
