      <Button x:Name="UpButton" Grid.Column="3" Tag="پوشهٔ بالاتر" Padding="10,6" Margin="9,0" VerticalAlignment="Center" FontSize="11"/>
      <Button x:Name="ExportButton" Grid.Column="4" Tag="خروجی CSV" Padding="10,6" VerticalAlignment="Center" FontSize="11"/>
     </Grid>
     <Grid Grid.Row="1" Margin="12,2,12,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="133"/><ColumnDefinition Width="161"/><ColumnDefinition Width="166"/></Grid.ColumnDefinitions>
      <Grid><TextBox x:Name="SearchBox" FontSize="12"/><TextBlock x:Name="SearchPlaceholder" Tag="جست‌وجو در این پوشه و زیرپوشه‌ها…" IsHitTestVisible="False" Foreground="#748894" FontSize="11" Margin="12,0" TextTrimming="CharacterEllipsis"/></Grid>
      <ComboBox x:Name="SizeFilter" Grid.Column="1" Margin="8,0,0,0" FontSize="11"/>
      <ComboBox x:Name="AgeFilter" Grid.Column="2" Margin="8,0,0,0" FontSize="11"/>
      <ComboBox x:Name="SortFilter" Grid.Column="3" Margin="8,0,0,0" FontSize="11"/>
     </Grid>
     <StackPanel x:Name="Categories" Grid.Row="2" Orientation="Horizontal" Margin="12,0"/>
