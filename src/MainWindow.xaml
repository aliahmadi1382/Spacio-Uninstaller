     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="MapTitle" Tag="نقشهٔ فضا" FontWeight="SemiBold"/><TextBlock x:Name="SnapshotInfo" Grid.Column="1" FontSize="10" Foreground="#85C6AE" Margin="14,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="MapHint" Grid.Column="2" Tag="برای ورود، روی پوشه کلیک کنید" FontSize="10" Foreground="#8199A6" HorizontalAlignment="Right"/></Grid>
     <Canvas x:Name="SpaceMap" Grid.Row="1" Background="Transparent" ClipToBounds="True" FlowDirection="LeftToRight"/>
    </Grid>
   </Border>
   <Border x:Name="ResultsPage" Grid.Row="4" Background="#161E24" BorderBrush="#2A363F" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
    <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="48"/><RowDefinition Height="35"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
     <Grid Margin="13,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="ListTitle" Tag="پوشه‌ها و فایل‌ها" FontWeight="SemiBold" Margin="0,0,12,0"/>
      <TextBlock x:Name="Breadcrumb" Grid.Column="1" Foreground="#91A9B8" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" FontSize="11"/>
